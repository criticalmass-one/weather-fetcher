# weather-fetcher is a cron-only application. It has no web front controller
# and nothing in this repository is meant to be reachable over HTTP.
#
# This file is a safety net for a document root that (mis)points at the
# repository root instead of public/. In that state a security audit was able
# to download /.env.dist and /.git/config: the deny rules generated by Plesk
# match the *raw* request URI, so percent-encoding the leading dot bypasses
# them (/%2eenv%2edist and /%2egit/config both returned HTTP 200 while the
# unencoded paths returned 403).
#
# The directives below match on the path Apache has already decoded and
# mapped, so percent-encoding does not get around them.
#
# NOTE: this only helps as long as requests actually reach Apache. The real
# fix is to switch the vhost off, or at minimum to point the document root at
# public/ -- see the pull request description.

# --- 1. Deny everything. There is nothing here to serve. -------------------
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# --- 2. Belt and braces: never serve dot files, even if some nested
#        configuration re-opens access. FilesMatch sees the decoded name,
#        so .env, %2eenv, .%65nv and friends are all caught here. ----------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- 3. Same for dot directories (.git/, .idea/) and for build metadata
#        that leaks the dependency tree. mod_rewrite's REQUEST_URI is
#        decoded, so this also catches the encoded variants. ---------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.                          - [F,L]
    RewriteRule (^|/)(composer|symfony)\.(json|lock)$ - [F,L]
</IfModule>

# --- 4. No directory listings. ---------------------------------------------
Options -Indexes
